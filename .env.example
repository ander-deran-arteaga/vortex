# ── Backend (apps/api) ─────────────────────────────────────────────
# The Uniswap Trade API key lives ONLY here. Never expose it through
# NEXT_PUBLIC_*, frontend source, or direct browser requests.
UNISWAP_API_KEY=
UNISWAP_API_BASE=https://trade-api.gateway.uniswap.org/v1

# Target chain: Arbitrum One (42161). Local fork uses 31337.
CHAIN_ID=42161
RPC_URL=https://arb1.arbitrum.io/rpc
FORK_RPC_URL=http://127.0.0.1:8545

PORT=3001
HOST=127.0.0.1

# EIP-712 signers (dev-only keys on fork; never commit real keys)
FEE_SIGNER_PRIVATE_KEY=
ROUTE_SIGNER_PRIVATE_KEY=
SOLVER_PRIVATE_KEY=

# Append-only JSON event/session store
STORE_DIR=./data

# ── Frontend (apps/web) ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_CHAIN_ID=42161
