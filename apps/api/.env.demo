# Vortex demo configuration — the judged run.
#
# Committed on purpose: it contains no secrets, and the demo dying to a silent
# CHAIN_ID mismatch is a far bigger risk than anything in here. Load it with:
#
#   pnpm --filter @vortex/api demo
#
# Prerequisite: the local chain is up and seeded —
#   ./scripts/bootstrap-fork.sh
#
# The API refuses to pretend: with CHAIN_ID=42161 and no Aqua strategy
# deployed there, swaps report AQUA_EXECUTION_UNAVAILABLE rather than
# fabricating an order. That is correct behaviour and NOT the demo config.

# The local chain that actually has the deployed + seeded contracts.
CHAIN_ID=31337
FORK_RPC_URL=http://127.0.0.1:8545

PORT=3001
HOST=127.0.0.1

# Aqua prices genuinely better than the external market by default. Flip the
# comparison with blockend's script, which moves the reference oracle so the
# maker really does price worse — it does not fake a comparison:
#   SCENARIO=UNISWAP_WINS forge script script/SetDemoScenario.s.sol --broadcast ...
AQUA_FIXTURE_PROFILE=competitive

# Labels simulated venues in the UI. The Grow external leg is the simulated
# venue, so this stays on for the demo.
DEMO_MODE=true

# Signers: left empty on purpose. On chain 31337 the backend falls back to
# anvil account #0 (a public, throwaway key) and ONLY on 31337. Never set real
# keys here.
FEE_SIGNER_PRIVATE_KEY=
ROUTE_SIGNER_PRIVATE_KEY=
SOLVER_PRIVATE_KEY=

# Uniswap Trade API. The key lives in the repo-root .env and is read from
# there; it is never committed. Note the Trade API cannot quote chain 31337,
# so the local demo shows the Aqua path and the Uniswap comparison is
# demonstrated against Arbitrum One separately.
UNISWAP_API_BASE=https://trade-api.gateway.uniswap.org/v1

STORE_DIR=./data
