{
  "name": "vortex",
  "private": true,
  "version": "0.1.0",
  "description": "Vortex — dual-intent Aqua and SwapVM liquidity system with a Uniswap v4 PermAMM and Uniswap Developer Platform integration",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check:commits": "bash scripts/check-commit-policy.sh",
    "dev:api": "pnpm --filter @vortex/api dev",
    "dev:web": "pnpm --filter @vortex/web dev"
  }
}
